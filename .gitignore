# Local config with machine-specific paths
config.yaml

# Controlled data (never commit), except the schema README
data/controlled/**
!data/controlled/
!data/controlled/README.md

# Allow open placeholders/docs; still ignore large binaries
data/open/**/*.nii
data/open/**/*.nii.gz
data/open/**/*.h5
data/open/**/*.trk
data/open/**/*.tck

# Legacy external data trees (if present)
derivatives/
results/

# Logs and caches
**/logs/
**/__pycache__/
**/.ipynb_checkpoints/
**/.ipyniivue_cache/
*.pyc
*.pyo

# Singularity images
*.sif

# Golden test local checkpoints (may contain identifiable keys)
code/tests/golden/baseline/
code/tests/golden/output/
tests/golden/baseline/
tests/golden/output/

# OS / editor
.DS_Store
._*
*.swp
*.swo
.vscode/
.idea/

# Work directories
**/work/
**/work_*/

# Licenses / secrets
**/license.txt

# Binary images
*.png
*.mat

# Large open products (populate locally / Zenodo; do not commit multi-GB trees)
data/open/gam/**
data/open/analysis/**
!data/open/gam/.gitkeep
!data/open/analysis/.gitkeep
# anon map is controlled
data/controlled/anon_id_map.csv

